# Finara — LLM provider configuration
# Copy to .env and adjust. docker-compose reads these automatically.

# Which LLM backend the ml-service uses: "ollama" (local) or "google" (Gemini API)
LLM_PROVIDER=google

# ── Local model (LLM_PROVIDER=ollama) ─────────────────────────────────────────
# Start the containerized model with:  docker compose --profile local up --build
# ollama-init builds "finara-gemma" from ml-service/Modelfile on first run.
OLLAMA_BASE_URL=http://ollama:11434
GEMMA_MODEL=finara-gemma
# To use Ollama running on your host instead of the container, set:
# OLLAMA_BASE_URL=http://host.docker.internal:11434  (and skip --profile local)

# ── Google Gemini (LLM_PROVIDER=google) ───────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
# Then run (no --profile local needed):  docker compose up --build
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
