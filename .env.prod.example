# Finara production secrets — used by docker-compose.prod.yml on the GCE VM.
# Copy to .env.prod on the VM and fill in real values. NEVER commit .env.prod.
#
#   cp .env.prod.example .env.prod   # then edit
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Host is everything between "@" and "/neondb" in the Neon connection string
# (keep the -pooler host). Do NOT include jdbc:, sslmode, or channel_binding here.
NEON_HOST=ep-solitary-sunset-axmyypd0-pooler.c-4.us-east-2.aws.neon.tech
NEON_USER=neondb_owner
NEON_PASSWORD=

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=finara_super_secret_key_change_in_production_2025
SERVICE_TOKEN=finara_internal_svc_token_2026

# ── Frontend origin (Netlify site URL) for CORS ───────────────────────────────
NETLIFY_URL=https://jd-finera.netlify.app
