              "raw": "{\n  \"startMonth\": \"2026-04\",\n  \"endMonth\": \"2026-04\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/ai/story", "host": ["{{base_url}}"], "path": ["api","ai","story"] }
          }
        },
        {
          "name": "Generate Story (force refresh)",
          "request": {
