          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalAmount\": 10000,\n  \"timeframeMonths\": 12,\n  \"startMonth\": \"2026-04\",\n  \"endMonth\": \"2026-04\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/ai/savings-plan", "host": ["{{base_url}}"], "path": ["api","ai","savings-plan"] }
          }
        },
        {
