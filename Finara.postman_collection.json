            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Where did I spend the most this month?\",\n  \"startMonth\": \"2026-04\",\n  \"endMonth\": \"2026-04\",\n  \"history\": []\n}"
            },
            "url": { "raw": "{{base_url}}/api/ai/chat", "host": ["{{base_url}}"], "path": ["api","ai","chat"] }
          }
        },
        {
