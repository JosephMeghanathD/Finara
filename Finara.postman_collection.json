        {
          "name": "Generate Multi-Month Story",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startMonth\": \"2026-01\",\n  \"endMonth\": \"2026-04\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/ai/story", "host": ["{{base_url}}"], "path": ["api","ai","story"] }
          }
        },
        {
          "name": "Explain Anomaly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": {{txn_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/api/ai/explain-anomaly", "host": ["{{base_url}}"], "path": ["api","ai","explain-anomaly"] }
          }
        },
        {
